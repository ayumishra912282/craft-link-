# CraftLink Backend Environment Configuration

# Application Port & Host
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Gemini AI API Key (Get from https://aistudio.google.com/)
# Leave empty to automatically run in deterministic high-fidelity Demo Mode
GEMINI_API_KEY=

# Supabase Configuration (Optional - falls back to high-performance local SQLite + JSON vector store)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
